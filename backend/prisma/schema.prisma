// Basmat Zaid — database schema
// Money is always stored as Decimal(10,2); never as floating point.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// Tracks whether an order's stock is currently taken out of inventory.
/// Restoration only happens from DEDUCTED -> RESTORED, exactly once.
enum InventoryStatus {
  NONE
  DEDUCTED
  RESTORED
}

enum MovementType {
  INITIAL_STOCK
  ORDER_DEDUCTION
  ORDER_CANCELLATION_RESTORE
  MANUAL_ADJUSTMENT
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  SELECT
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  username     String?   @unique
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           AdminSession[]
  inventoryMovements InventoryMovement[]
  statusChanges      OrderStatusHistory[]
}

model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  csrfToken   String
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  description        String?
  categoryId         String
  price              Decimal   @db.Decimal(10, 2)
  discountPrice      Decimal?  @db.Decimal(10, 2)
  /// Stock for products without variants. Products with active variants track stock per variant.
  stockQuantity      Int       @default(0)
  lowStockThreshold  Int       @default(5)
  sku                String?   @unique
  isActive           Boolean   @default(true)
  isFeatured         Boolean   @default(false)
  allowCustomization Boolean   @default(false)
  /// Set when a product that appears in historical orders is deleted (archived instead of removed).
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images             ProductImage[]
  variants           ProductVariant[]
  customFields       ProductCustomField[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([isActive, deletedAt])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  imageUrl  String
  sortOrder Int     @default(0)
  altText   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  /// Option group, e.g. "اللون"
  name            String
  /// Option value, e.g. "ذهبي"
  value           String
  priceAdjustment Decimal @default(0) @db.Decimal(10, 2)
  stockQuantity   Int     @default(0)
  sku             String? @unique
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([productId])
}

/// Admin-configurable customization inputs shown on the product page (e.g. "اسم الطفل").
model ProductCustomField {
  id         String          @id @default(cuid())
  productId  String
  label      String
  fieldType  CustomFieldType @default(TEXT)
  /// Allowed values for SELECT fields
  options    String[]        @default([])
  isRequired Boolean         @default(false)
  maxLength  Int             @default(100)
  sortOrder  Int             @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  /// Normalized local format, e.g. 0599123456
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model DeliveryArea {
  id                    String   @id @default(cuid())
  name                  String
  deliveryFee           Decimal  @db.Decimal(10, 2)
  isActive              Boolean  @default(true)
  estimatedDeliveryTime String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  orders Order[]
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  /// Secret token that lets the customer view their own order confirmation.
  trackingToken         String          @unique
  /// Client-generated key that makes order submission idempotent.
  idempotencyKey        String?         @unique
  customerId            String
  customerNameSnapshot  String
  customerPhoneSnapshot String
  recipientName         String?
  recipientPhone        String?
  deliveryMethod        DeliveryMethod
  deliveryAddress       String?
  deliveryAreaId        String?
  /// Snapshot of the delivery area name at order time
  deliveryArea          String?
  deliveryFee           Decimal         @default(0) @db.Decimal(10, 2)
  pickupLocation        String?
  /// Null with PICKUP means "as soon as it's ready"
  pickupTime            DateTime?
  subtotal              Decimal         @db.Decimal(10, 2)
  total                 Decimal         @db.Decimal(10, 2)
  totalQuantity         Int
  status                OrderStatus     @default(NEW)
  inventoryStatus       InventoryStatus @default(NONE)
  paymentMethod         PaymentMethod   @default(CASH)
  paymentStatus         PaymentStatus   @default(UNPAID)
  customerNotes         String?
  adminNotes            String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  deliveryAreaRef    DeliveryArea?        @relation(fields: [deliveryAreaId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  inventoryMovements InventoryMovement[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryMethod])
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String
  productId             String?
  variantId             String?
  productNameSnapshot   String
  productSkuSnapshot    String?
  productImageSnapshot  String?
  /// { name, value, sku } of the chosen variant, if any
  variantSnapshot       Json?
  /// [{ label, value }] customization entries
  customizationSnapshot Json?
  quantity              Int
  unitPrice             Decimal  @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id               String       @id @default(cuid())
  productId        String
  variantId        String?
  orderId          String?
  adminUserId      String?
  movementType     MovementType
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  reason           String?
  createdAt        DateTime     @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUser AdminUser?      @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  adminUserId    String?
  previousStatus OrderStatus?
  newStatus      OrderStatus
  note           String?
  createdAt      DateTime     @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model StoreSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

/// Per-year counter that produces order numbers like BZ-2026-0001.
model OrderSequence {
  year      Int @id
  lastValue Int @default(0)
}
