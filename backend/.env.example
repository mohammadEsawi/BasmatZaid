# Copy to backend/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/basmat_zaid?schema=public

# Comma-separated frontend origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (1 behind Nginx/Render/etc.); needed for correct rate limiting
TRUST_PROXY=0

SESSION_TTL_HOURS=12
# Use "none" only if frontend and API are on different sites (requires HTTPS)
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com

# Image storage: local | cloudinary
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=basmat-zaid

# First admin, used by `npm run db:seed` / `npm run admin:create`. 12+ characters with letters and digits.
ADMIN_NAME=مدير المتجر
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Adds demo products with placeholder images. Development only.
SEED_DEMO_DATA=false
