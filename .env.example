# Used by docker-compose.yml. Copy to .env and replace every value.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
# Public address of the site, e.g. https://basmatzaid.com
PUBLIC_ORIGIN=https://basmatzaid.com
HTTP_PORT=8080

# First admin. 12+ characters with letters and digits; there is no default password.
ADMIN_NAME=مدير المتجر
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to false only for testing over plain http://
COOKIE_SECURE=true

# local | cloudinary
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
